<resources>
    <!-- App name and identity -->
    <string name="app_name">M9 Box</string>
    <string name="account_type">network.m9.box</string>
    <string name="default_display_name_for_root_folder">M9 Box</string>

    <!-- Provider authorities (device-global: MUST be unique to coexist with other clients) -->
    <string name="authority">network.m9.box.provider</string>
    <string name="users_and_groups_search_authority">network.m9.box.providers.UsersAndGroupsSearchProvider</string>
    <string name="users_and_groups_share_with">network.m9.box.providers.UsersAndGroupsSearchProvider.action.SHARE_WITH</string>
    <string name="document_provider_authority">network.m9.box.documents</string>
    <string name="file_provider_authority">network.m9.box.files</string>
    <string name="image_cache_provider_authority">network.m9.box.imageCache.provider</string>

    <!-- User agent. The version is BuildConfig.UPSTREAM_VERSION, not versionName (see build.gradle.kts) -->
    <string name="nextcloud_user_agent">Mozilla/5.0 (Android) M9Box-android/%1$s%2$s</string>
    <string name="office_user_agent">Mozilla/5.0 (Android %1$s) Mobile M9Box-android/%2$s</string>

    <!-- Brand colors (sampled from M9 Box icon) -->
    <color name="primary">#116DF0</color>
    <color name="primary_dark">#0343CF</color>
    <color name="color_accent">#31B3FC</color>
    <color name="login_text_color">#ffffff</color>
    <color name="login_text_hint_color">#A9D3F7</color>

    <!-- Behavior: fleet still on NC 25, keep runtime theming from the instance -->
    <bool name="show_outdated_server_warning">false</bool>
    <bool name="is_branded_client">false</bool>
    <!-- Talk/Notes/Assistant are not part of the M9 offering yet; the drawer must
         not advertise apps the customer cannot use. Re-enable when they ship. -->
    <bool name="show_ecosystem_apps">false</bool>
    <!-- "Community" links to the Nextcloud project: not our brand, not our support
         channel. Upstream already gates it behind this flag. -->
    <bool name="participate_enabled">false</bool>
    <!-- No upstream intro tour: its slides advertise webmail and video calls, which M9 Box does
         not ship, plus "sign up with a provider" / "host your own server". The app opens on the
         login screen, and "add account" (drawer and Manage accounts) goes straight to login too.
         show_provider_or_own_installation=false also keeps an MDM DisableIntro=false from
         bringing the tour back (MDMConfig.showIntro needs both). -->
    <bool name="disable_intro">true</bool>
    <bool name="show_provider_or_own_installation">false</bool>
    <bool name="show_server_url_input">true</bool>

    <!-- Links (GPL/AGPL: source must be public) -->
    <string name="url_help">https://github.com/emiliofonseca-meile/m9box-android</string>
    <string name="privacy_url"></string>
    <string name="sourcecode_url" translatable="false">https://github.com/emiliofonseca-meile/m9box-android</string>
    <string name="url_imprint"></string>

    <!-- Splash -->
    <string name="splashScreenBold">M9</string>
    <string name="splashScreenNormal">Box</string>

