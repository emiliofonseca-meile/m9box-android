<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Same as the upstream Play Store flavor (src/gplay): nothing in the app installs
         packages, and Google Play restricts this permission to apps whose core purpose needs it. -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

</manifest>
